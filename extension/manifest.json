{
  "manifest_version": 3,
  "name": "Brit Placement Auto-Apply",
  "version": "2.0.0",
  "description": "Auto-apply to LinkedIn, Indeed, Glassdoor, UK job boards and company career sites from Placement OS loops.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "alarms",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Brit Placement Auto-Apply"
  }
}
