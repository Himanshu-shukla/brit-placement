# Optional. By default the app needs NO account and NO paid services.
# Local backend is fixed to 127.0.0.1:8765 for the packaged Chrome extension.
PLACEMENT_HOST=127.0.0.1
PLACEMENT_PORT=8765

# Reed API: obtain permitted developer credentials from Reed.
REED_API_KEY=

# Adzuna: commercial/ongoing use may require a license beyond evaluation.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# OPTIONAL zero-per-request-cost local LLM (Ollama; downloads model weights).
OLLAMA_MODEL=

# Scheduler runs inside `python app.py serve` (or Docker container).
PLACEMENT_SCHEDULER=1

# Employer-domain auto-submit: ALL three prerequisites must be satisfied:
# candidate permission, exact allowlisted hostname, and explicit global opt-in.
AUTO_SUBMIT_ENABLED=0
AUTO_APPLY_ALLOWED_HOSTS=

# For Docker Compose: Dockerfile (review-only) or Dockerfile.auto (includes Chromium).
PLACEMENT_DOCKERFILE=Dockerfile

# Reviewed outbound recruitment email; not required for job search.
# Google accounts may require an app password or another authorised SMTP account.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Optional read-only reply tracking; credentials stay only in your local environment.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
