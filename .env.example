# Everything below can also be set from the dashboard Settings page (stored in data/settings.json,
# which takes precedence). Use this file for Docker / VPS deployments.
PLACEMENT_HOST=127.0.0.1
PLACEMENT_PORT=8770
PLACEMENT_SCHEDULER=1

# AI: Groq powers screening answers, CV tailoring and recruiter emails.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Automatic applications
AUTO_SUBMIT_ENABLED=1
AUTO_APPLY_ALLOWED_HOSTS=*
DAILY_APPLY_LIMIT=40
APPLY_DELAY_MIN_SECONDS=45
APPLY_DELAY_MAX_SECONDS=120
TAILOR_CV=1

# Job boards with API keys (LinkedIn, Indeed, Glassdoor, NHS Jobs and remote boards need none)
REED_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=

# Recruiter emails. Gmail: smtp.gmail.com / 465 with a Google app password.
AUTO_EMAIL_ENABLED=1
DAILY_EMAIL_LIMIT=25
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=

# Docker Compose: Dockerfile.auto includes Chromium for server-side applications.
PLACEMENT_DOCKERFILE=Dockerfile.auto
